<?xml version="1.0" encoding="utf-8"?>
<!--
  LabVIEW FPGA CLIP Descriptor -- PAL B/W Stripe Test (NO BRAM)
  Revision 3: runtime stripe_width and stripe_dir controls.
  Target  : NI cRIO-9056  (Artix-7 XC7A75T)

  LabVIEW wiring:
    rst          -> FALSE  (or Boolean control)
    stripe_width -> U16 numeric control  (pixels or lines per stripe)
    stripe_dir   -> Boolean control      (FALSE=vertical, TRUE=horizontal)
    dac_out      -> unbundle -> Mod1/DIO0..DIO3  (NI-9401)
-->
<CLIPDeclaration>

  <Name>PAL_BW_Stripe_Test</Name>
  <GUID>{B7D3A2F1-4C8E-4A02-95B3-2D7F6E1C3A09}</GUID>
  <Version>3.0</Version>
  <Description>PAL B/W stripe pattern generator. No BRAM. Stripe width and direction (horizontal/vertical) controllable at runtime from LabVIEW.</Description>

  <HDLFileList>
    <HDLFile isTopLevelFile="false">
      <FileName>pal_timing.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
    <HDLFile isTopLevelFile="false">
      <FileName>pal_sync_gen.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
    <HDLFile isTopLevelFile="false">
      <FileName>pal_dac_mux.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
    <HDLFile isTopLevelFile="true">
      <FileName>pal_bw_stripe_top.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
  </HDLFileList>

  <SignalList>

    <CLIPSignal>
      <Name>clk</Name>
      <DataType>Clock</DataType>
      <Direction>ToCLIP</Direction>
      <ClockFrequencyInHz>40000000</ClockFrequencyInHz>
    </CLIPSignal>

    <CLIPSignal>
      <Name>rst</Name>
      <DataType>Boolean</DataType>
      <Direction>ToCLIP</Direction>
    </CLIPSignal>

    <!-- Stripe width: number of pixels (vertical) or lines (horizontal) per stripe -->
    <!-- Wire to a U16 numeric control on front panel. Default value: 40 -->
    <CLIPSignal>
      <Name>stripe_width</Name>
      <DataType>U16</DataType>
      <NumberOfBits>16</NumberOfBits>
      <Direction>ToCLIP</Direction>
    </CLIPSignal>

    <!-- Stripe direction: FALSE=vertical stripes, TRUE=horizontal stripes -->
    <CLIPSignal>
      <Name>stripe_dir</Name>
      <DataType>Boolean</DataType>
      <Direction>ToCLIP</Direction>
    </CLIPSignal>

    <!-- 4-bit DAC output: bit3->DIO0  bit2->DIO1  bit1->DIO2  bit0->DIO3 -->
    <CLIPSignal>
      <Name>dac_out</Name>
      <DataType>U8</DataType>
      <NumberOfBits>4</NumberOfBits>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>hsync_o</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>vsync_o</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>active_o</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

  </SignalList>

</CLIPDeclaration>
