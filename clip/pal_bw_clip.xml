<?xml version="1.0" encoding="utf-8"?>
<!--
  LabVIEW FPGA CLIP Descriptor -- PAL B/W Video (with BRAM)
  Target  : NI cRIO-9056  (Artix-7 XC7A75T)
  LabVIEW : 2019 SP1 or later with FPGA Module

  Steps to load in LabVIEW FPGA:
    1. Project Explorer -> FPGA Target
       Right-click -> New -> Component-Level IP
    2. Browse to this file
    3. Place CLIP node inside Single-Cycle Timed Loop at 40 MHz
    4. Wire rst -> FALSE
    5. Wire bram_addr + bram_en -> your FPGA array read logic
       Register result one SCTL cycle -> wire to bram_din
    6. Wire dac_out[3:0] -> Mod1/DIO0, DIO1, DIO2, DIO3  (NI-9401)
-->
<CLIPDeclaration>

  <Name>PAL_BW_Video_IP</Name>
  <GUID>{A3F2C1D0-7B4E-4F91-83A2-1C9E5D6B2F08}</GUID>
  <Version>1.0</Version>
  <Description>PAL black-and-white composite video generator. Reads 1-bit pixel data from FPGA memory via bram_addr/bram_din interface. Outputs 4-bit DAC value for NI-9401 DIO0-3 and R-2R ladder.</Description>

  <!-- HDL source files: dependencies first, top-level last -->
  <HDLFileList>
    <HDLFile isTopLevelFile="false">
      <FileName>pal_timing.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
    <HDLFile isTopLevelFile="false">
      <FileName>pal_sync_gen.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
    <HDLFile isTopLevelFile="false">
      <FileName>pal_dac_mux.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
    <HDLFile isTopLevelFile="true">
      <FileName>pal_bw_top.vhd</FileName>
      <FileDirectory>..\rtl</FileDirectory>
    </HDLFile>
  </HDLFileList>

  <SignalList>

    <!-- Clock: tied to SCTL clock automatically by LabVIEW -->
    <CLIPSignal>
      <Name>clk</Name>
      <DataType>Clock</DataType>
      <Direction>ToCLIP</Direction>
      <ClockFrequencyInHz>40000000</ClockFrequencyInHz>
    </CLIPSignal>

    <!-- Reset -->
    <CLIPSignal>
      <Name>rst</Name>
      <DataType>Boolean</DataType>
      <Direction>ToCLIP</Direction>
    </CLIPSignal>

    <!-- BRAM interface -->
    <CLIPSignal>
      <Name>bram_en</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>bram_addr</Name>
      <DataType>U32</DataType>
      <NumberOfBits>19</NumberOfBits>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>bram_din</Name>
      <DataType>Boolean</DataType>
      <Direction>ToCLIP</Direction>
    </CLIPSignal>

    <!-- 4-bit DAC output -->
    <CLIPSignal>
      <Name>dac_out</Name>
      <DataType>U8</DataType>
      <NumberOfBits>4</NumberOfBits>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <!-- Debug outputs -->
    <CLIPSignal>
      <Name>hsync_o</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>vsync_o</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

    <CLIPSignal>
      <Name>active_o</Name>
      <DataType>Boolean</DataType>
      <Direction>FromCLIP</Direction>
    </CLIPSignal>

  </SignalList>

</CLIPDeclaration>
